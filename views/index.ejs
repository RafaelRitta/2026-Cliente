<%- include('./header') %>

    <main>
        <div class="search-box">
            <input type="text" id="search-input" placeholder="Pesquisar por marca ou modelo (ex: SUV, Sedan)...">
        </div>

        <section class="vehicle-grid">
            <% if (veiculos && veiculos.length> 0) { %>
                <% veiculos.forEach(veiculo=> { %>
                    <article class="vehicle-card">
                        <img src="<%= veiculo.foto || 'https://via.placeholder.com/300x180' %>"
                            alt="Foto do <%= veiculo.marca %> <%= veiculo.modelo %>">
                        <div class="vehicle-info">
                            <h3>
                                <%= veiculo.marca %>
                                    <%= veiculo.modelo %>
                            </h3>
                            <p>Ano: <%= veiculo.ano %>
                            </p>
                            <p class="price">R$ <%= veiculo.precopordia.toFixed(2).replace('.', ',' ) %> / dia</p>
                        </div>
                        <div class="card-actions">
                            <button class="btn-fav" onclick="toggleFavorito(this)">&#9825;</button>
                            <a href="/agendamento?veiculo=<%= veiculo._id %>" class="btn-primary">Alugar</a>
                        </div>
                    </article>
                    <% }) %>
                        <% } else { %>
                            <p>Nenhum veículo cadastrado no momento.</p>
                            <% } %>
        </section>
    </main>

    <%- include('./footer') %>