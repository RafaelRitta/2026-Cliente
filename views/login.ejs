<%- include('./header') %>

    <main>
        <div class="form-container">
            <h2>Cadastro de Cliente</h2>
            <form action="#" method="POST">
                <div class="form-group">
                    <label for="nome">Nome Completo</label>
                    <input type="text" id="nome" name="nome" placeholder="Digite seu nome" required>
                </div>

                <div class="form-group">
                    <label for="numero">Telefone / Número</label>
                    <input type="text" id="numero" name="numero" placeholder="(00) 00000-0000" required>
                </div>

                <div class="form-group">
                    <label for="cpf">CPF</label>
                    <input type="text" id="cpf" name="cpf" placeholder="000.000.000-00" required>
                </div>

                <div class="form-group">
                    <label for="cnh">Número da CNH</label>
                    <input type="text" id="cnh" name="cnh" placeholder="00000000000" required>
                </div>

                <button type="submit" class="btn-primary" style="width: 100%;">Cadastrar</button>
            </form>
        </div>
    </main>

    <%- include('./footer') %>